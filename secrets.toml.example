# Pegar en Streamlit Community Cloud > App settings > Secrets
# NO subir las claves reales a GitHub.

[supabase]
url = "https://TU-PROYECTO.supabase.co"
service_role_key = "TU_SERVICE_ROLE_KEY"

[users.admin]
password = "CAMBIAR_CLAVE_ADMIN"
name = "Administrador"
role = "Administrador"

[users.terreno]
password = "CAMBIAR_CLAVE_TERRENO"
name = "Usuario Terreno"
role = "Editor"

[users.visor]
password = "CAMBIAR_CLAVE_VISOR"
name = "Usuario Consulta"
role = "Visor"
